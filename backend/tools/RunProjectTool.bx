/**
 * RunProjectTool - syntax-checks the project and returns a verdict, so the
 * agentic Builder can test its own output mid-generation.
 *
 * Uses Validator.checkSyntax() (`boxlang check`, parse-only) rather than a full
 * `bxAgents build` - cheaper (no project assembly, no extra JVM-per-turn cost
 * across up to 16 turns) and more directly correct: `bxAgents build`'s own
 * ProjectValidator never actually compiles tool .bx files, so it wouldn't catch
 * a syntax error in the file just written anyway. The full `bxAgents build`
 * still runs once as the final gate, in CoderBuilderAgent.implement() via QAAgent.
 */
class accessors="true" {

	property name="validator";
	property name="projectDir" type="string";

	function init( required string repoRoot, required string projectDir, string boxlangBin = "boxlang" ) {
		variables.validator  = new backend.lib.Validator( repoRoot = arguments.repoRoot, boxlangBin = arguments.boxlangBin );
		variables.projectDir = arguments.projectDir;
		return this;
	}

	function toTool() {
		return aiTool(
			"runProject",
			"Syntax-check the current project. Returns a JSON verdict: "
			& "checkPass, verdict, and a log tail.",
			() => jsonSerialize( variables.validator.checkSyntax( variables.projectDir ) )
		);
	}

}
