[Unit]
Description=BlueHats Agent Factory (BoxLang MiniServer)
After=network.target

[Service]
Type=simple
# CHANGE THESE to match your instance: the deploy user, and that user's home.
User=ubuntu
WorkingDirectory=/home/ubuntu/BlueHats
# Both BoxLang bin directories are required: the installer puts its own shims
# in ~/.local/bin but module executables (bxAgents) in ~/.boxlang/bin, and the
# backend resolves `bxAgents` from PATH. Omitting the latter starts the service
# fine and then fails every build at the coder step.
Environment="PATH=/home/ubuntu/.boxlang/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="BOXLANG_INSTALL_HOME=/home/ubuntu/.local/boxlang"
# ExecStart needs an absolute path to the binary - confirm yours with
# `which boxlang-miniserver` after deploy/setup.sh has run (the BoxLang
# installer puts its shims in ~/.local/bin).
ExecStart=/home/ubuntu/.local/bin/boxlang-miniserver /home/ubuntu/BlueHats/miniserver.json -c /home/ubuntu/BlueHats/boxlang.json
Restart=on-failure
RestartSec=5

# No secrets in the environment here on purpose - every visitor supplies
# their own AI provider key per request (see BuildResult's apiKey field).
# A .env is loaded by MiniServer itself (miniserver.json's "envFile"), and
# simply doesn't apply when the file is absent - nothing here needs it.
#
# The backend shells out to `bxAgents` / `boxlang` via ProcessBuilder, which
# resolves bare names from PATH on Linux - hence the PATH= line above rather
# than the BXAGENTS_BIN/BOXLANG_BIN overrides the Windows wrappers need.

[Install]
WantedBy=multi-user.target
