bx:header name="Content-Type" value="application/json";

try {
	body = jsonDeserialize( getHTTPRequestData().content ?: "{}" );
} catch ( any e ) {
	bx:header statusCode=400;
	writeOutput( jsonSerialize( { "error": "invalid JSON body" } ) );
	abort;
}

repoRoot = application.repoRoot;
factory  = new backend.AgentFactory(
	repoRoot    = repoRoot,
	provider    = body.provider ?: "",
	model       = body.model    ?: "",
	apiKey      = body.apiKey   ?: "",
	bxAgentsBin = server.system.environment.BXAGENTS_BIN ?: "bxAgents",
	boxlangBin  = server.system.environment.BOXLANG_BIN  ?: "boxlang"
);

// Progress reporting for the UI's build bar. Entirely optional.
// if len(buildId) === 0, it just leaves the factory with its default reporter and the build runs exactly as before.
// The client polls what this writes via GET /api/progress.bxs.
buildId  = ( body.buildId ?: "" ).reReplace( "[^A-Za-z0-9_-]", "", "all" ).left( 64 );
reporter = new backend.lib.ProgressReporter();
try {
	if ( len( buildId ) ) {
		new backend.lib.ProgressStore().sweep( application.progress );
		reporter = new backend.lib.ProgressReporter( application.progress, buildId );
		factory.withProgress( reporter );
	}
} catch ( any ignored ) {}

try {
	if ( !isNull( body.spec ) && isStruct( body.spec ) ) {
		report = factory.buildFromSpec( body.spec );
	} else if ( !isNull( body.prompt ) && len( trim( body.prompt ) ) ) {
		if ( !len( trim( body.apiKey ?: "" ) ) ) {
			bx:header statusCode=400;
			writeOutput( jsonSerialize( { "error": "provide an API key" } ) );
			abort;
		}
		// Clamped server-side: each repair round is a full Builder+QA(+Coder) pass plus
		// an LLM call, all inside this one request with no overall timeout - an
		// uncapped client-supplied value could tie up a MiniServer thread for a long time.
		maxRepairs = min( max( val( body.maxRepairs ?: 1 ), 0 ), 5 );
		report = factory.build( body.prompt, maxRepairs );
	} else {
		bx:header statusCode=400;
		writeOutput( jsonSerialize( { "error": "provide 'prompt' or 'spec'" } ) );
		abort;
	}
	reporter.finish( report.success ?: false );
	writeOutput( jsonSerialize( report ) );
} catch ( any e ) {
	reporter.fail( e.message );
	bx:header statusCode=500;
	writeOutput( jsonSerialize( { "error": e.message, "detail": e.detail ?: "" } ) );
}
